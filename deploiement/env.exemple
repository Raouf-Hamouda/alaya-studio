# A copier en .env a cote de docker-compose.yml, puis a remplir. Jamais dans le depot.
DOMAINE=alayafinejewelry.com
PUBLIC_URL=https://alayafinejewelry.com
# le premier compte du studio, cree au premier lancement (dix caracteres au moins)
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
# Stripe : cle secrete (sk_test_... pour l'essai, sk_live_... pour ouvrir). Vide = paiement ferme.
STRIPE_SECRET_KEY=
# Stripe : la cle de signature du webhook (whsec_...), vide = pas de webhook, les commandes se relisent a la main
STRIPE_WEBHOOK_SECRET=
# plafond d'envois de mails par 24 h (1800 par defaut)
MAILING_DAILY_CAP=
